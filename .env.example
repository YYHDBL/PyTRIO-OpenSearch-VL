# 在本机或远程运行环境填入；真实 .env 不提交 Git。
# PyTRIO：https://pytrio.com/keys
PYTRIO_API_KEY=

# 文字搜索：https://serper.dev/signup
SERPER_API_KEY=

# 以图搜图：https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# 可选；不提供 Key 也能使用 Jina 基础网页读取。
# https://jina.ai/reader/
JINA_API_KEY=

# 本实验裁判采用 Anthropic Messages 兼容接口。
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_PROTOCOL=anthropic
