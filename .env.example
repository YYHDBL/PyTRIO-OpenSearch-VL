# 在本机或远程运行环境填入；真实 .env 不提交 Git。
# PyTRIO：https://pytrio.com/keys
PYTRIO_API_KEY=

# 国内独立搜索与网页抓取：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 当前图搜图：豆包搜索 Global（visual），需对应服务权限。
DOUBAO_SEARCH_API_KEY=

# 历史 Serper 配置；新版七工具环境改用 DeepSeek。
SERPER_API_KEY=

# 历史 SerpApi 配置；新七工具实验使用下方百炼，不再消耗此 Key。
SERPAPI_API_KEY=

# 历史百炼配置，仅保留诊断代码；当前图搜改用豆包 Global。
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen3.8-27b

# 历史 Jina 配置；新版七工具环境改用 DeepSeek Fetch。
# https://jina.ai/reader/
JINA_API_KEY=

# 飞桨异步文档解析：真实 Token 仅填入私有 .env。
PADDLE_OCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLE_OCR_MODEL=PaddleOCR-VL-1.6
PADDLE_OCR_TOKEN=
# 可选显式代理，覆盖上传、轮询和结果下载；留空时直连。
PADDLE_OCR_PROXY=

# 本实验裁判采用 Anthropic Messages 兼容接口。
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_PROTOCOL=anthropic
